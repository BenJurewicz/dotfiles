[include]
	path = ~/.config/delta/catppuccin.gitconfig

[delta]
    features = catppuccin-mocha
	side-by-side = false # Prefer this set to true for cli but is set to false beacause thats better for lazygit
    commit-decoration-style = bold yellow box ul
    file-style = bold yellow ul
    navigate = true  # use n and N to move between diff sections

[machete "traverse"]
    push = false

[core]
    pager = delta
    editor = nvim
	hooksPath = ~/.config/git/hooks

[alias]
    m = machete

[interactive]
    diffFilter = delta

[push]
	useForceIfIncludes = true

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[user]
	name = Benjamin Jurewicz
	email = bjurewicz@internships.antmicro.com
[init]
	defaultBranch = main
